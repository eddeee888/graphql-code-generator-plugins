{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "declaration": true,
    "types": ["node"]
  },
  "exclude": ["vite.config.ts", "src/**/*.spec.ts"],
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../server-config/tsconfig.lib.json"
    }
  ]
}
